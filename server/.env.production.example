# TEMPLATE ONLY. Do not commit real passwords or SESSION_SECRET.
# Runtime API uses ONLY APP_DATABASE_URL. DATABASE_URL belongs exclusively
# in migration/cleanup job credentials, never in the web process environment.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
APP_DATABASE_URL=postgresql://finpilot_app:REPLACE_ME@127.0.0.1:5432/finpilot
CLIENT_ORIGIN=https://finpilot.example
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# Use 'loopback' for a proxy on the same machine; configure your own network.
# Or 'direct' if the API has no proxy and your host is correctly firewalled.
TRUSTED_PROXY_CIDRS=loopback
