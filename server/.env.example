NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://finpilot:finpilot_dev_password@127.0.0.1:5435/finpilot
CLIENT_ORIGIN=http://localhost:5173

# Use a different, cryptographically random value in production (>= 32 characters).
SESSION_SECRET=finpilot-local-development-only-secret-change

# Limited PostgreSQL role for the web API. The migration runner provisions it.
# Set a unique strong password before production deployment.
APP_DATABASE_URL=postgresql://finpilot_app:finpilot_app_dev_password@127.0.0.1:5435/finpilot
